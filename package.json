{
  "name": "biodata-cogify",
  "version": "2.2.0",
  "description": "Free Online Marriage Biodata Maker by Cogify.me (biodata.cogify.me) — 242+ Cultural & Modern A4 Templates, 14 Structural Layouts, Instant Live Preview, 300 DPI PDF, HD PNG & Editable Word (.docx) Export with Zero Watermark.",
  "homepage": "https://biodata.cogify.me",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shubham-sharma8/biodata.git"
  },
  "bugs": {
    "url": "https://github.com/Shubham-sharma8/biodata/issues"
  },
  "author": {
    "name": "Cogify.me",
    "url": "https://cogify.me"
  },
  "license": "MIT",
  "keywords": [
    "marriage-biodata",
    "biodata-maker",
    "marriage-biodata-maker",
    "matrimonial-biodata",
    "shadi-biodata",
    "hindu-marriage-biodata",
    "muslim-nikah-biodata",
    "sikh-marriage-biodata",
    "jain-marriage-biodata",
    "christian-marriage-biodata",
    "marathi-lagna-biodata",
    "gujarati-marriage-biodata",
    "kundali-biodata",
    "biodata-pdf-generator",
    "biodata-word-format",
    "cloudflare-workers",
    "cogify"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-seo-pages.mjs",
    "preview": "vite preview",
    "cf:deploy": "npm run build && npx wrangler deploy",
    "cf:dev": "npm run build && npx wrangler dev",
    "ingest": "node scripts/ingest-templates.mjs",
    "db:setup": "node scripts/setup-cloudflare-d1-r2.mjs",
    "db:list": "node scripts/query-d1-downloads.mjs",
    "d1:migrate:local": "npx wrangler d1 execute biodata --local --file=./migrations/0001_init_biodata_tables.sql",
    "d1:migrate:remote": "npx wrangler d1 execute biodata --remote --file=./migrations/0001_init_biodata_tables.sql",
    "test": "node --test tests/quality-assurance.test.mjs"
  },
  "dependencies": {
    "docx": "^9.12.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "vite": "^8.3.4"
  }
}
